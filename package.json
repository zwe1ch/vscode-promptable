{
  "name": "promptable",
  "displayName": "Promptable",
  "description": "Copy files and folders as prompt-ready AI context. Supports folders, multi-select, .gitignore, and binary-safe output.",
  "version": "1.2.1",
  "publisher": "zwe1ch",
  "author": {
    "name": "Rayk Jackisch",
    "email": "rayk@jackisch.net"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "categories": [
    "Programming Languages",
    "Machine Learning"
  ],
  "keywords": [
    "ai",
    "prompt",
    "llm",
    "chatgpt",
    "claude",
    "context",
    "copy",
    "developer-tools",
    "gitignore",
    "code-review"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptable.copy",
        "title": "Copy as AI Context",
        "category": "Promptable"
      },
      {
        "command": "promptable.copyIgnoringGitignore",
        "title": "Copy as AI Context (Ignore .gitignore)",
        "category": "Promptable"
      },
      {
        "command": "promptable.copyChanged",
        "title": "Copy All Changed Files as AI Context",
        "category": "Promptable",
        "icon": "$(copy)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "promptable.copy",
          "group": "9_cutcopypaste@4",
          "when": "editorTextFocus"
        }
      ],
      "explorer/context": [
        {
          "command": "promptable.copy",
          "group": "5_copy@2",
          "when": "resourceScheme == file || resourceScheme == folder"
        },
        {
          "command": "promptable.copyIgnoringGitignore",
          "group": "5_copy@3",
          "when": "resourceScheme == file || resourceScheme == folder"
        }
      ],
      "scm/title": [
        {
          "command": "promptable.copyChanged",
          "group": "navigation@10",
          "when": "scmProvider == git"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "dependencies": {
    "ignore": "^7.0.6"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.2",
    "@types/vscode": "1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "eslint": "^10.8.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zwe1ch/vscode-promptable.git"
  },
  "bugs": {
    "url": "https://github.com/zwe1ch/vscode-promptable/issues"
  },
  "homepage": "https://github.com/zwe1ch/vscode-promptable#readme",
  "license": "MIT"
}
